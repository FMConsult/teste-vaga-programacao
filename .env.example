# ============================================================
# Typebot — variáveis para Portainer
# ============================================================
# No Portainer: Stacks → Add stack → Environment variables
# Cole cada linha como Name / Value (sem o "=" se usar Advanced mode,
# ou cole o bloco inteiro no modo "Advanced mode" / "Load from .env file").
#
# Gere o ENCRYPTION_SECRET com:
#   openssl rand -base64 24 | tr -d '\n' ; echo
# ============================================================

# --- Obrigatórias ---
ENCRYPTION_SECRET=troque-por-uma-chave-de-32-caracteres

# URL pública do builder (painel de criação)
# Ex.: https://typebot.seudominio.com  ou  http://IP:8080
NEXTAUTH_URL=https://typebot.seudominio.com

# URL pública do viewer (bots publicados)
# Ex.: https://bot.seudominio.com  ou  http://IP:8081
NEXT_PUBLIC_VIEWER_URL=https://bot.seudominio.com

# E-mail do admin (recebe plano UNLIMITED automaticamente)
ADMIN_EMAIL=admin@seudominio.com

# --- Banco (padrão bate com o compose) ---
POSTGRES_PASSWORD=typebot
DATABASE_URL=postgresql://postgres:typebot@typebot-db:5432/typebot

# --- Portas no host (opcional) ---
BUILDER_PORT=8080
VIEWER_PORT=8081
TYPEBOT_VERSION=latest

# --- Plano padrão de novos workspaces ---
DEFAULT_WORKSPACE_PLAN=UNLIMITED
DISABLE_SIGNUP=false

# ============================================================
# Autenticação — configure PELO MENOS um provedor
# Docs: https://docs.typebot.com/self-hosting/configuration
# ============================================================

# --- Opção 1: Login por e-mail (SMTP) — recomendado serviço externo ---
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
NEXT_PUBLIC_SMTP_FROM="Typebot <noreply@seudominio.com>"

# --- Opção 2: Login com Google (opcional) ---
# GOOGLE_AUTH_CLIENT_ID=
# GOOGLE_AUTH_CLIENT_SECRET=

# ============================================================
# Storage S3 (opcional — uploads de imagens/arquivos nos bots)
# ============================================================
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=typebot
# S3_ENDPOINT=storage.seudominio.com
# S3_PORT=443
# S3_SSL=true
